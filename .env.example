APP_NAME=Async URL Shortener
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/url_shortener
REDIS_URL=redis://localhost:6379/0
SHORT_DOMAIN=http://localhost:8000
CACHE_TTL_SECONDS=3600
CACHE_LOCK_TTL_SECONDS=5
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
REDIS_PUBSUB_PREFIX=analytics:user:
REDIS_CLICK_STREAM=analytics:clicks
REDIS_CLICK_GROUP=analytics-workers
REDIS_CLICK_DEAD_LETTER_STREAM=analytics:clicks:dead
REDIS_CLICK_MAX_ATTEMPTS=5
REDIS_CLICK_CLAIM_IDLE_MS=30000
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
